@InventoryManagement.Api_HostAddress = http://localhost:5161

### Get all products

GET {{InventoryManagement.Api_HostAddress}}/api/products
Accept: application/json


### Get product by ID

GET {{InventoryManagement.Api_HostAddress}}/api/products/{{keyboardId}}
Accept: application/json


### Search products by name

GET {{InventoryManagement.Api_HostAddress}}/api/products?search=Keyboard
Accept: application/json


### Sort products by name

GET {{InventoryManagement.Api_HostAddress}}/api/products?sortBy=name
Accept: application/json


### Sort products by price

GET {{InventoryManagement.Api_HostAddress}}/api/products?sortBy=price
Accept: application/json


### Sort products by quantity

GET {{InventoryManagement.Api_HostAddress}}/api/products?sortBy=quantity
Accept: application/json


### Get low stock products

GET {{InventoryManagement.Api_HostAddress}}/api/products/low-stock?threshold=25
Accept: application/json


### Create keyboard

POST {{InventoryManagement.Api_HostAddress}}/api/products
Content-Type: application/json

{
  "name": "Keyboard",
  "description": "Mechanical keyboard",
  "price": 79.99,
  "quantity": 15
}


### Create mouse

POST {{InventoryManagement.Api_HostAddress}}/api/products
Content-Type: application/json

{
  "name": "Mouse",
  "description": "Wireless mouse",
  "price": 39.99,
  "quantity": 12
}


### Update keyboard

PUT {{InventoryManagement.Api_HostAddress}}/api/products/{{keyboardId}}
Content-Type: application/json

{
  "name": "Gaming Keyboard",
  "description": "RGB mechanical keyboard",
  "price": 99.99,
  "quantity": 10
}


### Update mouse

PUT {{InventoryManagement.Api_HostAddress}}/api/products/{{mouseId}}
Content-Type: application/json

{
  "name": "Gaming Mouse",
  "description": "Wireless gaming mouse",
  "price": 49.99,
  "quantity": 8
}


### Add inventory

PATCH {{InventoryManagement.Api_HostAddress}}/api/products/{{keyboardId}}/stock
Content-Type: application/json

{
  "change": 10
}


### Remove inventory

PATCH {{InventoryManagement.Api_HostAddress}}/api/products/{{keyboardId}}/stock
Content-Type: application/json

{
  "change": -3
}


### Delete product

DELETE {{InventoryManagement.Api_HostAddress}}/api/products/{{keyboardId}}


### Test insufficient inventory

PATCH {{InventoryManagement.Api_HostAddress}}/api/products/{{keyboardId}}/stock
Content-Type: application/json

{
  "change": -1000
}


### Test product validation

POST {{InventoryManagement.Api_HostAddress}}/api/products
Content-Type: application/json

{
  "name": "",
  "description": "Invalid product",
  "price": -50,
  "quantity": -10
}


### Test invalid low stock threshold

GET {{InventoryManagement.Api_HostAddress}}/api/products/low-stock?threshold=-1
Accept: application/json