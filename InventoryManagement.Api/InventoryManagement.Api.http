@InventoryManagement.Api_HostAddress = http://localhost:5161

### Get all products

GET {{InventoryManagement.Api_HostAddress}}/api/products
Accept: application/json

### Search products by name

GET {{InventoryManagement.Api_HostAddress}}/api/products?search=Keyboard
Accept: application/json


### Get product by ID

GET {{InventoryManagement.Api_HostAddress}}/api/products/10
Accept: application/json


### Create product

POST {{InventoryManagement.Api_HostAddress}}/api/products
Content-Type: application/json

{
  "name": "Keyboard",
  "description": "Mechanical keyboard",
  "price": 79.99,
  "quantity": 15
}

### Create product

POST {{InventoryManagement.Api_HostAddress}}/api/products
Content-Type: application/json

{
  "name": "Mouse",
  "description": "Wireless mouse",
  "price": 39.99,
  "quantity": 12
}


### Update product

PUT {{InventoryManagement.Api_HostAddress}}/api/products/10
Content-Type: application/json

{
  "id": 10,
  "name": "Gaming Keyboard",
  "description": "RGB mechanical keyboard",
  "price": 99.99,
  "quantity": 10
}

### Update product

PUT {{InventoryManagement.Api_HostAddress}}/api/products/11
Content-Type: application/json

{
  "name": "Gaming Mouse",
  "description": "Wireless gaming mouse",
  "price": 49.99,
  "quantity": 8
}

### Get low stock products

GET {{InventoryManagement.Api_HostAddress}}/api/products/low-stock?threshold=-1
Accept: application/json


### Add inventory

PATCH {{InventoryManagement.Api_HostAddress}}/api/products/10/stock
Content-Type: application/json

{
  "change": 10
}


### Remove inventory

PATCH {{InventoryManagement.Api_HostAddress}}/api/products/10/stock
Content-Type: application/json

{
  "change": -3
}


### Test insufficient inventory

PATCH {{InventoryManagement.Api_HostAddress}}/api/products/10/stock
Content-Type: application/json

{
  "change": -1000
}


### Test product validation

POST {{InventoryManagement.Api_HostAddress}}/api/products
Content-Type: application/json

{
  "name": "",
  "description": "Invalid product",
  "price": -50,
  "quantity": -10
}


### Delete product

DELETE {{InventoryManagement.Api_HostAddress}}/api/products/10